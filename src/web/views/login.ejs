<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đăng nhập & Đăng ký | BioLink</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#c2b6a6] min-h-screen flex items-center justify-center p-4">
  <div class="bg-white p-8 rounded-3xl shadow-xl max-w-md w-full">
    <!-- Header -->
    <div class="text-center mb-6">
      <div class="w-14 h-14 bg-black text-white rounded-2xl flex items-center justify-center mx-auto mb-3 shadow">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
        </svg>
      </div>
      <h1 class="text-2xl font-bold font-mono text-gray-900">BioLink Hub</h1>
      <p class="text-xs text-gray-500 font-mono mt-1">Nền tảng trang cá nhân & liên kết thông minh</p>
    </div>

    <!-- Tab Switcher -->
    <div class="flex bg-gray-100 p-1 rounded-2xl mb-6">
      <button id="tabLogin" type="button" class="w-1/2 py-2 text-sm font-semibold rounded-xl bg-white text-gray-900 shadow-sm transition">
        Đăng nhập
      </button>
      <button id="tabRegister" type="button" class="w-1/2 py-2 text-sm font-semibold rounded-xl text-gray-500 hover:text-gray-900 transition">
        Đăng ký
      </button>
    </div>

    <!-- Alert Box -->
    <div id="alertBox" class="hidden mb-4 p-3 rounded-xl text-sm font-medium"></div>

    <!-- Form Đăng nhập -->
    <form id="formLogin" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-gray-600 mb-1 font-mono">TÊN ĐĂNG NHẬP</label>
        <input type="text" id="loginUsername" required autocomplete="username"
          placeholder="VD: username"
          class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-black">
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-600 mb-1 font-mono">MẬT KHẨU</label>
        <input type="password" id="loginPassword" required autocomplete="current-password"
          placeholder="••••••••"
          class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-black">
      </div>
      <button type="submit" id="btnLoginSubmit"
        class="w-full bg-black text-white font-semibold py-3 rounded-xl hover:bg-gray-800 transition shadow">
        Đăng nhập
      </button>
    </form>

    <!-- Form Đăng ký -->
    <form id="formRegister" class="space-y-4 hidden">
      <div>
        <label class="block text-xs font-semibold text-gray-600 mb-1 font-mono">TÊN ĐĂNG NHẬP (HANDLE)</label>
        <div class="relative">
          <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-gray-400 font-mono text-sm">@</span>
          <input type="text" id="regUsername" required autocomplete="username"
            placeholder="username"
            pattern="^[a-zA-Z0-9_-]+$"
            title="Chỉ chứa chữ, số, dấu gạch nối và gạch dưới"
            class="w-full pl-8 pr-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-black">
        </div>
        <p class="text-[11px] text-gray-400 mt-1">Đường dẫn trang của bạn sẽ là: /username</p>
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-600 mb-1 font-mono">MẬT KHẨU</label>
        <input type="password" id="regPassword" required autocomplete="new-password" minlength="6"
          placeholder="Tối thiểu 6 ký tự"
          class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-black">
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-600 mb-1 font-mono">XÁC NHẬN MẬT KHẨU</label>
        <input type="password" id="regPasswordConfirm" required autocomplete="new-password" minlength="6"
          placeholder="Nhập lại mật khẩu"
          class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-black">
      </div>
      <button type="submit" id="btnRegSubmit"
        class="w-full bg-black text-white font-semibold py-3 rounded-xl hover:bg-gray-800 transition shadow">
        Tạo tài khoản
      </button>
    </form>

    <div class="mt-6 pt-4 border-t text-center text-xs text-gray-500">
      Cần key kích hoạt? Sử dụng lệnh <span class="font-mono font-bold text-gray-800">/genkey</span> trên Discord Bot.
    </div>
  </div>

  <script>
    const tabLogin = document.getElementById('tabLogin');
    const tabRegister = document.getElementById('tabRegister');
    const formLogin = document.getElementById('formLogin');
    const formRegister = document.getElementById('formRegister');
    const alertBox = document.getElementById('alertBox');

    function showAlert(message, isError = true) {
      alertBox.textContent = message;
      alertBox.className = isError 
        ? 'mb-4 p-3 rounded-xl text-sm font-medium bg-red-50 text-red-600 border border-red-200 block'
        : 'mb-4 p-3 rounded-xl text-sm font-medium bg-green-50 text-green-700 border border-green-200 block';
    }

    function clearAlert() {
      alertBox.className = 'hidden mb-4 p-3 rounded-xl text-sm font-medium';
      alertBox.textContent = '';
    }

    function setTab(tab) {
      clearAlert();
      if (tab === 'register') {
        tabRegister.className = 'w-1/2 py-2 text-sm font-semibold rounded-xl bg-white text-gray-900 shadow-sm transition';
        tabLogin.className = 'w-1/2 py-2 text-sm font-semibold rounded-xl text-gray-500 hover:text-gray-900 transition';
        formLogin.classList.add('hidden');
        formRegister.classList.remove('hidden');
      } else {
        tabLogin.className = 'w-1/2 py-2 text-sm font-semibold rounded-xl bg-white text-gray-900 shadow-sm transition';
        tabRegister.className = 'w-1/2 py-2 text-sm font-semibold rounded-xl text-gray-500 hover:text-gray-900 transition';
        formRegister.classList.add('hidden');
        formLogin.classList.remove('hidden');
      }
    }

    tabLogin.addEventListener('click', () => setTab('login'));
    tabRegister.addEventListener('click', () => setTab('register'));

    // Kiểm tra query param ?tab=register hoặc url /register
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('tab') === 'register' || window.location.pathname === '/register') {
      setTab('register');
    }

    // Xử lý Đăng nhập
    formLogin.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearAlert();
      const username = document.getElementById('loginUsername').value.trim();
      const password = document.getElementById('loginPassword').value;
      const btn = document.getElementById('btnLoginSubmit');

      btn.disabled = true;
      btn.textContent = 'Đang đăng nhập...';

      try {
        const res = await fetch('/api/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password })
        });
        const data = await res.json();
        if (res.ok) {
          if (data.is_activated) {
            window.location.href = '/dashboard';
          } else {
            window.location.href = '/redeem';
          }
        } else {
          showAlert(data.error || 'Đăng nhập không thành công.');
        }
      } catch (err) {
        showAlert('Không thể kết nối đến máy chủ. Vui lòng thử lại sau.');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Đăng nhập';
      }
    });

    // Xử lý Đăng ký
    formRegister.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearAlert();
      const username = document.getElementById('regUsername').value.trim();
      const password = document.getElementById('regPassword').value;
      const confirm = document.getElementById('regPasswordConfirm').value;
      const btn = document.getElementById('btnRegSubmit');

      if (password !== confirm) {
        showAlert('Mật khẩu xác nhận không khớp.');
        return;
      }
      if (password.length < 6) {
        showAlert('Mật khẩu phải từ 6 ký tự trở lên.');
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Đang đăng ký...';

      try {
        const res = await fetch('/api/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password })
        });
        const data = await res.json();
        if (res.ok) {
          showAlert('Đăng ký thành công! Đang tự động đăng nhập...', false);
          // Tự động đăng nhập
          const loginRes = await fetch('/api/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username, password })
          });
          const loginData = await loginRes.json();
          if (loginRes.ok) {
            setTimeout(() => {
              window.location.href = loginData.is_activated ? '/dashboard' : '/redeem';
            }, 800);
          } else {
            setTab('login');
            document.getElementById('loginUsername').value = username;
          }
        } else {
          showAlert(data.error || 'Đăng ký không thành công.');
        }
      } catch (err) {
        showAlert('Không thể kết nối đến máy chủ. Vui lòng thử lại sau.');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Tạo tài khoản';
      }
    });
  </script>
</body>
</html>
